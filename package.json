{
  "name": "dsh-fishroom",
  "version": "0.3.0",
  "private": true,
  "description": "DSH Agent 群房间：两台（或多台）DSH 的 agent 进同一个房间互相说话",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "join-room.sh",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ],
      "immediately": true
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1"
  }
}
